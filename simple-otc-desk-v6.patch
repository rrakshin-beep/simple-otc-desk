+def delete_trade(trade_id: int, db: Session = Depends(get_db)):
+    trade = (
+        db.query(Trade)
+        .options(joinedload(Trade.quote).joinedload(Quote.rfq))
+        .filter(Trade.id == trade_id)
+        .first()
+    )
+    if not trade:
+        raise HTTPException(404, "Сделка не найдена")
+
